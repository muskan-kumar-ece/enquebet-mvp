# ==============================================================================
# ENQUEbet Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development, or set these variables in
# the Vercel Project Settings (Environment Variables) for staging/production.
#
# IMPORTANT:
# Variables prefixed with NEXT_PUBLIC_ are bundled into client-side JavaScript.
# NEVER put private API secrets, database passwords, or Redis URLs here!
# Any changes to NEXT_PUBLIC_ variables require a new Vercel deployment/build.
# ==============================================================================

# --- Backend API Endpoint ---
# Production / Staging: HTTPS URL of the deployed Render backend service (with /api/v1)
# Local development default: http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_API_URL=https://enquebet-mvp-534x.onrender.com/api/v1

# --- Real-Time WebSockets ---
# Production / Staging: Secure WebSocket URL (wss://) matching the Render service host (without path)
# Local development default: ws://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=wss://enquebet-mvp-534x.onrender.com

# --- Optional Client Settings ---
# Client fetch timeout in milliseconds (default: 15000 ms)
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Optional: Cloudinary client-side upload config (if direct-to-cloud upload is enabled)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=enquebet_uploads
