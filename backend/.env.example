# ==============================================================================
# ENQUEbet Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development or set these variables in the
# Render Dashboard (Environment tab) for staging/production deployment.
# NEVER commit real credentials or .env files to Git.
# ==============================================================================

# --- Core Django Settings ---
# Set DEBUG=False for staging and production deployments.
DEBUG=False

# A secure random secret key (e.g. generated via `python -c "import secrets; print(secrets.token_urlsafe(50))"`)
SECRET_KEY=replace-with-a-cryptographically-strong-secret-key-min-50-chars

# Comma-separated list of allowed hostnames without scheme (e.g. render domain or custom domain)
# Note: Render automatically provides RENDER_EXTERNAL_HOSTNAME which is also accepted.
ALLOWED_HOSTS=localhost,127.0.0.1,enquebet-mvp-534x.onrender.com

# --- Database (Neon PostgreSQL) ---
# Neon connection string. For production serverless connections, use the pooled connection string (?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Set to True only if developing offline without access to PostgreSQL:
USE_SQLITE=False

# --- Redis & Django Channels (WebSockets) ---
# Connection string for Redis (Upstash, Redis Cloud, or managed Redis).
# Use rediss:// (with double 's') for TLS-enabled connections.
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@your-redis-host.com:6379

# Backward-compatibility fallback if using Upstash-specific variable:
UPSTASH_REDIS_URL=

# Channel Layer queue tuning (optional)
CHANNEL_LAYER_CAPACITY=1500
CHANNEL_LAYER_EXPIRY=60

# --- Cross-Origin Resource Sharing (CORS) & CSRF ---
# Set to True for testing across local networks/devices (default: False)
CORS_ALLOW_ALL_ORIGINS=False
# Comma-separated list of trusted frontend origins without trailing slashes
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://enquebet.vercel.app
# Comma-separated origin regexes (e.g. for Vercel preview branch deployments)
CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.vercel\.app$
# CSRF trusted origins for cross-origin POST requests
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://enquebet.vercel.app,https://*.vercel.app,https://enquebet-mvp-534x.onrender.com

# --- Media Storage (Cloudinary) ---
# Configure Cloudinary for persistent media file storage (avatars, attachments, project images).
# Method 1: Discrete keys (preferred)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Method 2: Connection URL format (alternative)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Production Security & HTTPS Hardening ---
# SSL redirect behind Render reverse proxy
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HTTP Strict Transport Security (HSTS)
# Recommended: Keep at 0 for initial staging until custom domains are verified.
# Once custom domain is live and permanent, set to 31536000 (1 year).
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
X_FRAME_OPTIONS=DENY

# --- Logging ---
DJANGO_LOG_LEVEL=INFO
